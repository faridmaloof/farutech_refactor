# ==============================================================================
# FaruTech Framework Automation - example/test project .gitignore
# ==============================================================================
# This tree is an executable example/reference. Ignore generated test/build data,
# local configuration, IDE state and credentials; keep source and documentation.

# .NET / MSBuild
**/[Bb]in/
**/[Oo]bj/
**/[Dd]ebug/
**/[Rr]elease/
**/[Ll]og/
**/[Ll]ogs/
**/TestResults/
**/.vs/
**/[Pp]ublish[Pp]rofiles/
**/artifacts/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.rsuser
*.sln.docstates
*.sln.ide
*.sln.iml

# JetBrains Rider
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/
*.code-workspace

# NuGet / package artifacts
**/packages/
.nuget/
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# Test / coverage / reporting
TestResults/
test-results/
coverage/
*.trx
*.coverage
*.coveragexml
*.coverlet.json
coverage*.json
coverage*.xml
coverage*.info
AllureResults/
allure-results/
allure-report/
*.sarif
*.codeanalysis

# Playwright / browser artifacts
playwright-report/
playwright/.cache/
*.webm
*.trace.zip
*.har

# Evidence generated by tests
evidence/
screenshots/
videos/
traces/

# Node.js (used by Playwright tooling where applicable)
node_modules/
.npm/
.pnpm-store/
.yarn/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local configuration / environment
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.backup
*.local.json
*.local.yaml
*.local.yml
secrets.json
**/secrets.json
appsettings.*.local.json
appsettings.Local.json

# Certificates / private keys
*.pfx
*.p12
*.jks
*.keystore
*.key
*.cer
*.crt
*.pem
keystore/

# Docker / Kubernetes local overrides
docker-compose.override.yml
*.local.yaml
*.local.yml

# OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Temporary / backup files
*.old
*.bak
*.tmp
*.temp
*~
*.swp
*.swo

# Documentation generated output
docfx/_site/

# Analysis / profiler / crash output
*.perf
*.dmp
*.prof
*.profraw

# Legacy tooling
[Ss]vn/
$tf/
*.ncrunch*
*CrunchSolution.*
*.CodeRush*
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
StyleCopReport.xml
BenchmarkDotNet.Artifacts/
*.publish
SetupLog.txt
