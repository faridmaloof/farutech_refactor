# ==============================================================================
# Infraestructura FaruTech — PLANTILLA de configuración (TASK-002, R-01 corregido)
#
# JERARQUÍA DE RESOLUCIÓN (de mayor a menor prioridad):
#   1. Secrets manager  → en K3s (Dev/QA/Staging/Prod) vía Kubernetes Secrets
#                        o en local vía vars de entorno del shell.
#   2. `.env`           → archivo LOCAL, gitignored, con los valores reales
#                        del ambiente (NUNCA se commitea).
#   3. default          → SOLO placeholders explícitos `CHANGE_ME_OR_SET_SECRET`.
#                        Cualquier default real fue eliminado a propósito.
#
# ⚠️  REGLA DE SEGURIDAD (R-01):
#   - Este archivo NO contiene valores reales.
#   - Los ambientes NO-locales (dev/qa/staging/prod) DEBEN proveer cada variable
#     y fallan si detectan un placeholder (ver scripts/validate-env.*).
#
# CÓMO USARLO EN LOCAL:
#   Copiar a `.env` y completar con los valores de tu ambiente. En desarrollo
#   local el valor conviene que coincida con las credenciales ya usadas para
#   no perder los volúmenes de datos existentes (ver README de infraestructura).
# ==============================================================================

# ---- MySQL ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_OR_SET_SECRET
MYSQL_DATABASE=CHANGE_ME_OR_SET_SECRET
MYSQL_USER=CHANGE_ME_OR_SET_SECRET
MYSQL_PASSWORD=CHANGE_ME_OR_SET_SECRET

# ---- PostgreSQL -------------------------------------------------------
POSTGRES_DB=CHANGE_ME_OR_SET_SECRET
POSTGRES_USER=CHANGE_ME_OR_SET_SECRET
POSTGRES_PASSWORD=CHANGE_ME_OR_SET_SECRET

# ---- MongoDB ----------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=CHANGE_ME_OR_SET_SECRET
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_OR_SET_SECRET

# ---- pgAdmin ----------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=CHANGE_ME_OR_SET_SECRET
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_OR_SET_SECRET

# ---- mongo-express ----------------------------------------------------
MONGO_EXPRESS_USER=CHANGE_ME_OR_SET_SECRET
MONGO_EXPRESS_PASSWORD=CHANGE_ME_OR_SET_SECRET