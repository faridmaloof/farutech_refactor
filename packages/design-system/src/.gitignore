# ==============================================================================
# FaruTech Design System - package-local .gitignore
# ==============================================================================
# Keep package source, package.json, package-lock.json, tsconfig and build config
# versioned. Ignore only local/generated material.

# Dependencies / package-manager state
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/patches/

# Build output / caches
dist/
dist-ssr/
build/
.vite/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo

# Test / coverage output
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
*.lcov
*.webm
*.trace.zip
*.har

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / local-only configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup
*.local.json
*.local.yaml
*.local.yml

# Package artifacts generated locally
*.tgz
*.tar.gz

# Editors / IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.suo
*.user
*.rsuser
*.swp
*.swo
*.sw?

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
