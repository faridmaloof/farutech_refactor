<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>

    <PackageId>EnterpriseAutomation.Framework</PackageId>
    <Version>1.0.0</Version>
    <Authors>FaruTech</Authors>
    <Company>FaruTech</Company>
    <Description>FaruTech reusable automation framework for API, integration and E2E testing using ScreenPlay, web automation, database tools, configuration and BDD support.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>farutech;automation;testing;e2e;api;integration;playwright;screenplay;reqnroll;dotnet</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/faridmaloof/farutech_refactor.git</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageProjectUrl>https://github.com/faridmaloof/farutech_refactor/tree/main/packages/framework-automation/src/Framework.Core</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Suppress analyzer version warning -->
    <SkipUpgradeNetAnalyzersNuGetWarning>true</SkipUpgradeNetAnalyzersNuGetWarning>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Extensions -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />

    <!-- Playwright -->
    <PackageReference Include="Microsoft.Playwright" Version="1.58.0" />

    <!-- Database -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.7.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.2.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />

    <!-- API -->
    <PackageReference Include="RestSharp" Version="114.0.0" />

    <!-- Polly -->
    <PackageReference Include="Polly" Version="8.5.0" />

    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry" Version="1.15.0" />

    <!-- Reqnroll for BDD helpers -->
    <PackageReference Include="Reqnroll" Version="3.3.3" />

    <!-- Bogus -->
    <PackageReference Include="Bogus" Version="35.6.5" />

    <!-- Validation -->
    <PackageReference Include="FluentValidation" Version="11.9.0" />

    <!-- FluentAssertions for assertions in Questions -->
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

</Project>
