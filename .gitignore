```
# Dependencies
node_modules/

# Build outputs
dist/
build/
target/

# Environment variables
.env
.env.local
.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp

# Python cache (if any Python files exist in the project)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
.coverage

# OS generated files
.DS_Store
Thumbs.db

# Additional common ignores
*.out
*.exe
*.dll
*.so
*.a
*.obj
*.class
*.jar
*.war
*.ear
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# TypeScript/JavaScript build outputs
*.tsbuildinfo
*.js.map
*.jsx.map
*.ts.map
*.tsx.map

# Vite specific
.vite/

# Lock files (already tracked in some cases but generally safe to ignore globally)
yarn.lock
pnpm-lock.yaml

```