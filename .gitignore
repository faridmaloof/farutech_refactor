# =============================================================================
# FaruTech Monorepo — .gitignore raíz
# =============================================================================
# Reglas generales que aplican a TODOS los subproyectos del repositorio.
# Cada proyecto (apps/*, packages/*, tests/*, infrastructure/*) añade además
# sus reglas específicas en su propio .gitignore.
#
# NOTA: los archivos .env.example SÍ se versionan y NO deben ser ignorados.
# =============================================================================

# Dependencies
node_modules/
venv/
.venv/
__pycache__/
.mypy_cache/
.pytest_cache/
target/
.gradle/

# Build artifacts
dist/
build/
*.pyc
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Editor/IDE files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.tmp

# System files
.DS_Store
Thumbs.db
# Variables de entorno — nunca versionar secretos (los .env.example sí se versionan)
.env
.env.local
.env.*.local
.env.backup
.env.development
.env.staging
.env.production

# Logs
*.log

# Coverage
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst