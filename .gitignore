# ==============================================================================
# FaruTech monorepo - root .gitignore
# ==============================================================================
# Keep source, templates and documentation versioned. Ignore generated, local,
# IDE, build, test, cache and secret material.

# Operating systems
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Editors / IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.iml
*.ipr
*.iws
*.suo
*.user
*.userosscache
*.rsuser
*.sln.docstates
*.sln.ide
*.sln.iml
*.swp
*.swo
*.sw?
*~
.project
.classpath
.c9/
*.launch
.settings/

# .NET / Visual Studio / MSBuild
**/[Bb]in/
**/[Oo]bj/
**/[Dd]ebug/
**/[Rr]elease/
**/[Ll]og/
**/[Ll]ogs/
**/TestResults/
**/[Pp]ublish[Pp]rofiles/
**/.vs/
**/artifacts/
x64/
x86/
arm/
arm64/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/

# NuGet generated / package artifacts
**/packages/*
!packages/
!packages/**/
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
.nuget/

# Package source trees must remain trackable
!packages/design-system/
!packages/design-system/**
!packages/framework-automation/
!packages/framework-automation/**

# Node.js / React / Vite / TypeScript
**/node_modules/
**/.npm/
**/.pnpm-store/
**/.yarn/
**/.yarn/cache/
**/.yarn/install-state.gz
**/.yarn/unplugged/
**/.yarn/build-state.yml
**/.yarn/patches/
**/jspm_packages/
**/.vite/
**/.cache/
**/.parcel-cache/
**/.turbo/
**/.eslintcache
**/*.tsbuildinfo
**/dist/
**/build/
**/coverage/
**/*.lcov
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
corepack-debug.log*

# Playwright / browser-test artifacts
**/.playwright/
**/playwright/.cache/
**/test-results/
**/playwright-report/
**/blob-report/
**/*.trace.zip
**/*.webm
**/*.har

# Test / quality / reporting artifacts
**/allure-results/
**/allure-report/
**/AllureResults/
**/*.trx
**/*.coverage
**/*.coveragexml
**/*.coverlet.json
**/evidence/
**/screenshots/
**/videos/
**/traces/
**/*.sarif
**/*.codeanalysis

# Laravel / PHP
**/vendor/
composer.phar
**/Homestead.json
**/Homestead.yaml
**/storage/*.key
**/public/storage
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/logs/*
**/bootstrap/cache/*

# Environment files and local secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.env.backup
*.local.json
*.local.yaml
*.local.yml
secrets.json
**/secrets.json

# Certificates / private keys / credentials
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.cer
*.crt
**/keystore/
.mysql-credentials.generated
*.credentials.generated

# Docker / Kubernetes local overrides
**/docker-compose.override.yml

# Documentation / generated site output
docfx/_site/

# Profiling / crash dumps / local performance output
*.prof
*.profraw
*.dmp
*.perf

# Legacy tooling / build systems
[Ss]vn/
$tf/
*.ncrunch*
*CrunchSolution.*
*.CodeRush*
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
StyleCopReport.xml
BenchmarkDotNet.Artifacts/
*.publish
SetupLog.txt

# Temporary / backup files
*.tmp
*.temp
*.old
*.bak
