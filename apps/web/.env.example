# ==========================================================================
# FaruTech Web — Variables del stack Docker (copiar a `.env`; NO versionar)
# Compose las lee automáticamente para flags/build-args.
# Los SECRETOS del backend viven únicamente en apps/backend/.env (montado rw).
# ==========================================================================

# --- Documentación (Swagger): true = local/dev/qa · false = producción ---
SWAGGER_UI_ENABLED=true

# --- Orígenes permitidos de la SPA (CORS, coma separada por ambiente) ---
CORS_ALLOWED_ORIGINS=http://farutech.local

# --- Frontend: URL pública de la API (se hornea en el build de Vite) ---
VITE_API_URL=http://api.farutech.local