{
  "Framework": {
    "Environment": "Production",
    "Culture": "es-CO",
    "Headless": true,
    "Timeouts": {
      "GlobalTimeoutSeconds": 60,
      "NavigationTimeoutSeconds": 60,
      "ActionTimeoutSeconds": 30
    },
    "Evidence": {
      "Screenshot": "OnFailure",
      "Video": "OnFailure",
      "Trace": false,
      "StoragePath": "./evidence"
    },
    "Parallelism": {
      "MaxWorkers": 8,
      "EnableSharding": true
    },
    "Observability": {
      "Mode": "Direct",
      "EnableMetrics": true,
      "EnableTracing": true,
      "PrometheusEndpoint": "http://prometheus:9090",
      "GrafanaEndpoint": "http://grafana:3000",
      "OtlpEndpoint": "http://otel-collector:4317",
      "ExportIntervalSeconds": 30,
      "AutoOpenGrafana": false
    }
  },
  "Device": {
    "Browser": "Chromium",
    "Headless": true,
    "Viewport": [ 1920, 1080 ]
  },
  "Allure": {
    "ResultsDirectory": "allure-results",
    "ProjectName": "Farutech API Tests (Production)",
    "AutoOpenReport": false,
    "ReportPort": 56789
  },
  "FaruTech": {
    "ApiBaseUrl": "http://api.farutech.local",
    "AdminApi": {
      "Email": "CHANGE_ME_OR_SET_SECRET",
      "Password": "CHANGE_ME_OR_SET_SECRET"
    },
    "Postgres": {
      "ConnectionString": "Host=127.0.0.1;Port=5432;Database=farutech;Username=farutech;Password=CHANGE_ME_OR_SET_SECRET;SslMode=Disable"
    }
  }
}