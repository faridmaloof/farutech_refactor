{
  "name": "farutech-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FaruTech — Front door oficial. React + TypeScript + Vite + Tailwind v4.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:seo": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run build && npm run build:seo"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.6.3",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
